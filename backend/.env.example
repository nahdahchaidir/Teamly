# SQLite works out of the box. For PostgreSQL use:
# DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/teampilot
DATABASE_URL=sqlite:///./teampilot.db
SECRET_KEY=change-this-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
FRONTEND_ORIGIN=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
