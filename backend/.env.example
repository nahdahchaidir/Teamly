# Database & Auth
DATABASE_URL=sqlite:///./teampilot.db
SECRET_KEY=change-this-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
FRONTEND_ORIGIN=http://localhost:5173

# Konfigurasi Notifikasi Gmail SMTP
# Panduan Google App Password (Sandi Aplikasi):
# 1. Buka https://myaccount.google.com/security
# 2. Aktifkan 'Verifikasi 2-Langkah' (2-Step Verification)
# 3. Cari / buka 'Sandi Aplikasi' (App Passwords)
# 4. Beri nama aplikasi (contoh: Teamly) lalu klik Buat/Generate
# 5. Salin 16 karakter sandi (tanpa spasi) ke SMTP_PASSWORD di bawah ini
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=emailkamu@gmail.com
SMTP_PASSWORD=abcdxyzpqrs1234
SMTP_FROM_EMAIL=emailkamu@gmail.com
SMTP_USE_TLS=true
